# ============================================================================
# MerQato AI Resort Platform — environment template
# Copy to `.env` (backend / agent-api) or `.env.local` (Next.js) and fill in.
# NEVER commit the filled-in file. No secrets are hardcoded in code.
# ============================================================================

# ---- FastAPI agent service (services/agent-api/.env) ----------------------
# Runtime: "development" | "production"
ENVIRONMENT=development

# OpenRouter — optional environment fallback. The preferred per-resort key is
# stored from Admin > AI Provider and encrypted server-side.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Ollama — must be reachable from the FastAPI machine/network.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Encrypted per-resort AI provider settings. Generate a Fernet key once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_SETTINGS_ENCRYPTION_KEY=
PROVIDER_SETTINGS_PATH=.data/provider-settings.json

# Supabase (multi-tenant source of truth; service-role key stays server-side)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Qdrant (per-tenant vector storage / retrieval)
QDRANT_URL=
QDRANT_API_KEY=

# Knowledge embeddings (OpenAI provider; needs OPENAI_API_KEY below)
KNOWLEDGE_EMBEDDING_PROVIDER=openai
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Admin APIs — server-to-server shared secret sent by the Next.js BFF as
# X-Admin-Token. Browsers never see it. If unset, admin routes fail closed.
ADMIN_API_TOKEN=

# ---- Next.js public site (root .env.local) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never exposed to the browser):
SUPABASE_SERVICE_ROLE_KEY=
AGENT_API_URL=http://localhost:8000
ADMIN_API_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
