# ============================================================================
# MerQato AI Resort Platform — environment template
# Copy to `.env` (backend / agent-api) or `.env.local` (Next.js) and fill in.
# NEVER commit the filled-in file. No secrets are hardcoded in code.
# ============================================================================

# ---- FastAPI agent service (services/agent-api/.env) ----------------------
# Runtime: "development" | "production"
ENVIRONMENT=development

# OpenRouter — the resort's own LLM key (MerQato never bills tokens).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Supabase (multi-tenant source of truth; service-role key stays server-side)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Qdrant (per-tenant vector storage / retrieval)
QDRANT_URL=
QDRANT_API_KEY=

# Knowledge embeddings (OpenAI provider; needs OPENAI_API_KEY below)
KNOWLEDGE_EMBEDDING_PROVIDER=openai
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Admin knowledge API — server-to-server shared secret sent by the Next.js
# BFF as X-Admin-Token. Browsers never see it. If unset, admin routes fail
# closed (503). Use a long random value.
ADMIN_API_TOKEN=

# ---- Next.js public site (root .env.local) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never exposed to the browser):
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
NEXT_PUBLIC_APP_URL=http://localhost:3000
