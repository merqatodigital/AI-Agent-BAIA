# ============================================================================
# MerQato AI Resort Platform — environment template
# Copy to `.env` (backend / agent-api) or `.env.local` (Next.js) and fill in.
# NEVER commit the filled-in file. No secrets are hardcoded in code.
# ============================================================================

# ---- FastAPI agent service (services/agent-api/.env) ----------------------
ENVIRONMENT=development

# Default OpenRouter configuration. Admin settings may override these values
# per resort. OpenRouter supports both free and paid models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Local Ollama. The agent service detects installed models through /api/tags.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Encrypted per-resort AI runtime settings.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_SETTINGS_ENCRYPTION_KEY=
PROVIDER_SETTINGS_PATH=.data/provider-settings.json

# Supabase (multi-tenant source of truth; service-role key stays server-side)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Qdrant (per-tenant vector storage / retrieval)
QDRANT_URL=
QDRANT_API_KEY=

# Knowledge embeddings
KNOWLEDGE_EMBEDDING_PROVIDER=fastembed
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_API_KEY=

# Admin APIs — server-to-server shared secret sent by the Next.js BFF.
ADMIN_API_TOKEN=

# ---- Next.js public site (root .env.local) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AGENT_API_URL=http://localhost:8000
ADMIN_API_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime choices are saved in Admin:
# 1. OpenRouter direct
# 2. Local Ollama direct
# 3. Hermes Agent, powered by either OpenRouter or Ollama
